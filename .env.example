# Recommended: node scripts/configure.mjs creates a private .env safely.
# For manual configuration, generate separate strings: openssl rand -hex 24
# Hex avoids special characters that would need URL encoding in DATABASE_URL.
POSTGRES_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@planroom.local
SEED_EXAMPLE=true

# Must match the address used in the browser, including scheme and port.
APP_URL=http://localhost:3210
PLANROOM_PORT=3210
PLANROOM_BIND_ADDRESS=127.0.0.1
